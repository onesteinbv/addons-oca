<data>
    <record id="view_crowdfunding_challenge_form" model="ir.ui.view">
        <field name="model">crowdfunding.challenge</field>
        <field name="arch" type="xml">
            <form>
                <field name="currency_id" invisible="1" />
                <header>
                    <button class="btn btn-primary" invisible="state != 'draft'" type="object" name="action_open">Open</button>
                    <button class="btn" invisible="state == 'draft'" type="object" name="action_cancel">Cancel</button>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_payment_transactions"
                                class="oe_stat_button"
                                type="object"
                                icon="fa-money"
                                invisible="transaction_count == 0">
                            <field name="transaction_count" widget="statinfo" string="Transactions"/>
                        </button>
                        <field name="is_published" widget="website_redirect_button"/>
                    </div>
                    <h1>
                        <field name="name" placeholder="Name" />
                    </h1>
                    <group name="main">
                        <field name="is_published" widget="boolean_toggle" />
                        <field name="pledged_amount" />
                        <field name="claimed_partner_id" readonly="True" />
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Describe the challenge" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_crowdfunding_challenge_list" model="ir.ui.view">
        <field name="model">crowdfunding.challenge</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="state" />
                <field name="website_published" />
            </list>
        </field>
    </record>

    <record id="action_crowdfunding_challenge" model="ir.actions.act_window">
        <field name="name">Challenges</field>
        <field name="res_model">crowdfunding.challenge</field>
        <field name="view_mode">list,form</field>
    </record>
</data>
