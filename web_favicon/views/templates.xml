<odoo>
    <template id="favicon_icon" inherit_id="web.layout" name="Web layout">
        <xpath expr="//head/link[@rel='shortcut icon']" position="before">
            <t t-set="x_icon" t-value="env['res.company'].sudo()._get_favicon()"/>
        </xpath>
    </template>
</odoo>
