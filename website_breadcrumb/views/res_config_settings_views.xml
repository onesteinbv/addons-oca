<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">
           res.config.settings.view.form.inherit.website.breadcrumb
       </field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_info_settings']" position="inside">
                <setting id="website_breadcrumb" help="Show Breadcrumbs on the website">
                    <field name="breadcrumb_enabled" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
