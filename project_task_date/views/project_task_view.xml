<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_task_form2" model="ir.ui.view">
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_deadline']" position="before">
                <label for="date_planned_start" string="Planned On"/>
                <div name="dates" class="o_row">
                    <field name="date_planned_start" widget="daterange" options='{"related_end_date": "date_planned_end"}'/>
                    <i class="fa fa-long-arrow-right mx-2" />
                    <field name="date_planned_end" widget="daterange" options='{"related_start_date": "date_planned_start"}'/>
                </div>
            </xpath>
            <xpath expr="//field[@name='date_assign']" position="after">
                <field name="date_start" />
                <field name="date_end" />
            </xpath>
        </field>
    </record>
</odoo>
